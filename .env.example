# ─── Agents OS configuration ─────────────────────────────────────────────
# Copy to .env and fill in. Everything is optional except what you want to use.
# The server also reads these from the environment directly.

# ── HTTP ──
PORT=8787
# Public origin of this server (used for OAuth redirect URIs)
PUBLIC_URL=http://localhost:8787
# Where the browser UI lives in dev mode (OAuth callback redirects there);
# defaults to PUBLIC_URL when unset.
WEB_ORIGIN=http://localhost:5173

# ── LLM (any OpenAI-compatible chat-completions endpoint) ──
# Default: DeepSeek V4 Pro. Examples for other providers:
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
#   DeepSeek:    LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-v4-pro   (or deepseek-v4-flash)
#   Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1 LLM_MODEL=<model-id>
#   Mock (no key needed, for offline smoke tests): LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
# DeepSeek V4 thinking mode (optional): enabled | disabled. Empty = API default.
# With thinking enabled, reasoning_effort (high | max) controls depth.
LLM_THINKING_MODE=
LLM_REASONING_EFFORT=high
# Extra JSON headers merged into LLM requests (e.g. {"X-Title":"agent-os"})
LLM_EXTRA_HEADERS=
# Max tool-calling iterations per agent run
AGENT_MAX_STEPS=12
# Truncate tool results to this many characters before sending back to the LLM
TOOL_RESULT_MAX_CHARS=8000

# ── Google OAuth (https://console.cloud.google.com → OAuth client, type "Web application") ──
# Authorized redirect URIs must include:  <PUBLIC_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Scopes are split into two groups because Google refuses to combine YouTube
# scopes with Drive scopes in a single consent request ("scopes that cannot be
# requested together"). Each group is granted in its own consent step and Google
# merges the grants into one token. Identity scopes (openid/email/profile) are
# added automatically.
GOOGLE_SCOPES_WORKSPACE=https://www.googleapis.com/auth/calendar.events,https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/drive.file,https://www.googleapis.com/auth/documents,https://www.googleapis.com/auth/spreadsheets
# (documents/spreadsheets enable Markdown-formatted Google Docs and reading
#  Sheet values; if you connected before they were added, reconnect once.)
GOOGLE_SCOPES_YOUTUBE=https://www.googleapis.com/auth/youtube.readonly,https://www.googleapis.com/auth/youtube.upload
# (A legacy single GOOGLE_SCOPES list is still accepted and auto-split: YouTube
#  entries are routed into their own consent group.)

# ── GitHub (personal access token) ──
# Create one at https://github.com/settings/tokens — a classic token with the
# "repo" scope, or a fine-grained token with read/write on Contents, Issues and
# Pull requests for the repositories your agents should work on.
GITHUB_TOKEN=

# ── Vercel (access token) ──
# Create one at https://vercel.com/account/tokens — "Full Account" scope so
# agents can list projects/deployments and redeploy.
VERCEL_TOKEN=
# Optional: when the token belongs to a Vercel team, set the team id so API
# calls are scoped to that team (visible in the token dialog / team URL).
VERCEL_TEAM_ID=

# ── Supabase ──
# Project ref: the "xxx" part of your project URL https://xxx.supabase.co
# (Dashboard → Project Settings → General). The service_role key is under
# Dashboard → Project Settings → API. It bypasses RLS — protect it.
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=
# Optional personal access token for the management API (needed only for the
# supabase_run_sql and supabase_list_tables tools):
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ── Data ──
DATA_DIR=./data
